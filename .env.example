# Notion integration secret (notion.so/profile/integrations > New integration)
NOTION_TOKEN=secret_xxx
# ID of the RSVP database (the 32-character part of its URL, before ?v=)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: n8n webhook that pings you on WhatsApp for each new RSVP
N8N_WEBHOOK_URL=
